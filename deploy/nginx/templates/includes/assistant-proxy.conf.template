# Included only inside the assistant location.
proxy_pass http://assistant:8000;
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host ${SITE_DOMAIN};
proxy_set_header X-Forwarded-Host ${SITE_DOMAIN};
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Real-IP $remote_addr;
proxy_connect_timeout 5s;
# The assistant enforces its own 30-second idle limit towards the AI
# service; allow a little longer here so its error message reaches the user.
proxy_read_timeout 60s;
proxy_send_timeout 60s;
proxy_buffering off;
proxy_cache off;
