# The application receives exactly one normalized, trusted X-Forwarded-For IP.
# Uvicorn must use --no-proxy-headers; Django's proxy count remains exactly 1.
server {
    listen 8081 default_server;
    server_name _;
    return 444;
}

server {
    listen 8081;
    server_name ${SITE_DOMAIN};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 308 https://${SITE_DOMAIN}$request_uri;
    }
}

server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 8443 ssl;
    server_name ${SITE_DOMAIN};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin always;
    limit_conn per_ip_connections 32;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # This namespace must never be served from a disk volume.
    location ^~ /private_media/ { return 404; }
    location ~ /\. { return 404; }

    location /static/ {
        alias /srv/static/;
        autoindex off;
        expires 1h;
    }

    location /media/ {
        alias /srv/media/;
        autoindex off;
    }

    location ~ ^/api/(?:v1/)?(?:inquiries|contact|contact-messages)/?$ {
        limit_req zone=public_forms burst=4 nodelay;
        include /tmp/nginx-conf/includes/api-proxy.conf;
    }

    # Website assistant: separate service, long-lived streamed answers.
    location ~ ^/api/(?:v1/)?assistant/chat/?$ {
        limit_req zone=public_forms burst=4 nodelay;
        include /tmp/nginx-conf/includes/assistant-proxy.conf;
    }

    location ~ ^/api/(?:v1/)?assistant/ {
        limit_req zone=public_api burst=40 nodelay;
        include /tmp/nginx-conf/includes/assistant-proxy.conf;
    }

    location /api/ {
        limit_req zone=public_api burst=40 nodelay;
        include /tmp/nginx-conf/includes/api-proxy.conf;
    }

    location /admin/ {
        limit_req zone=admin_requests burst=10 nodelay;
        include /tmp/nginx-conf/includes/api-proxy.conf;
    }

    location / {
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host ${SITE_DOMAIN};
        proxy_set_header X-Forwarded-Host ${SITE_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 90s;
    }
}

# Server rendering uses this private, read-only gateway. Port 8080 is NOT
# published by Compose. It avoids permitting internal names in ALLOWED_HOSTS.
server {
    listen 8080;
    server_name _;
    access_log off;
    location /api/ {
        limit_except GET HEAD { deny all; }
        include /tmp/nginx-conf/includes/api-proxy.conf;
    }
    location / { return 404; }
}
