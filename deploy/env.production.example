# Generate the private deployment file with:
# python3 deploy/configure.py init --import-existing
# This example contains no usable passwords. Never commit deploy/.env.production.
DEPLOY_PROJECT_NAME=axle-production
APP_VERSION=1.0.0
# Fill with the full commit SHA used to build the release images.
GIT_SHA=
SITE_DOMAIN=axle.wan-shang.com
BACKEND_IMAGE=axle-api:production
FRONTEND_IMAGE=axle-web:production
CLAMAV_IMAGE=clamav/clamav:stable@sha256:e19130cdebaeacc71fa46eab3ed6f69941f2f22aa5e08d55e9197f8edf43ce5e
NGINX_IMAGE=axle-nginx:production
NGINX_BASE_IMAGE=nginx:stable-alpine@sha256:47928bf67eb62a1863cb08d9ecb52d3e704304ba614eaee17884204677702951

# Paths are relative to deploy/, including when an external --env-file is used.
TLS_CERT_DIR=./tls
ACME_WEBROOT=./acme-webroot
CLOUDFLARE_REALIP_CONFIG=./nginx/cloudflare-realip.conf
NGINX_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# The initializer and application use different database roles and passwords.
POSTGRES_DB=axle
POSTGRES_USER=axle_admin
POSTGRES_PASSWORD=
APP_DB_USER=axle_app
APP_DB_PASSWORD=
REDIS_PASSWORD=
DJANGO_SECRET_KEY=

# Only these public values reach the frontend build. The secret stays in backend services.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Website assistant: AI providers and their API keys are entered in the admin
# (Assistant > AI providers) and stored encrypted with DJANGO_SECRET_KEY.
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_TAGLINE=
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_SALES_PHONE=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_MAP_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# SMTP account password means provider application password when required.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=
SALES_NOTIFICATION_EMAIL=

# Baseline for the selected 8-core / 32-GB server; actual architecture is checked.
API_WORKERS=2
API_CONCURRENCY=8
CELERY_CONCURRENCY=2
CLAMAV_MEMORY_LIMIT=4g
API_MEMORY_LIMIT=1g
FRONTEND_MEMORY_LIMIT=768m
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=512m
REDIS_MAXMEMORY=256mb
