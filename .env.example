# Copy to .env and replace before production deployment.
POSTGRES_DB=trailer_parts
POSTGRES_USER=trailer
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
REDIS_PORT=6379
# Required: Redis rejects unauthenticated non-loopback clients under protected-mode.
REDIS_PASSWORD=change-me-locally
CELERY_CONCURRENCY=2

DJANGO_SECRET_KEY=replace-this-in-production
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_BEHIND_PROXY=False
DJANGO_NUM_PROXIES=0
# Optional WSGI META header names injected by a trusted GeoIP-aware edge.
DJANGO_GEOIP_COUNTRY_HEADER=
DJANGO_GEOIP_CITY_HEADER=
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DATABASE_URL=postgresql://trailer:change-me-locally@localhost:5432/trailer_parts
REDIS_URL=redis://:change-me-locally@127.0.0.1:6379/0
DJANGO_CACHE_URL=redis://:change-me-locally@127.0.0.1:6379/1
# Optional worker cache URL; leave blank to use Redis inside Compose.
# Set this separately when the API's host-side cache URL uses localhost.
CELERY_CACHE_URL=
# Optional, already URL-encoded connection URLs for externally managed services.
# Leave blank to use Compose services with the raw passwords above.
CELERY_DATABASE_URL=
CELERY_REDIS_URL=
# Bound queue-publish latency when Redis is unavailable while retaining retries.
CELERY_REDIS_SOCKET_CONNECT_TIMEOUT=1
CELERY_REDIS_SOCKET_TIMEOUT=2
CELERY_TASK_PUBLISH_MAX_RETRIES=2
CELERY_TASK_PUBLISH_RETRY_INTERVAL=0.25
DEFAULT_FROM_EMAIL=website@localhost
SALES_NOTIFICATION_EMAIL=sales@localhost
DJANGO_PUBLIC_BASE_URL=http://localhost:8000
DJANGO_PUBLIC_MEDIA_URL=http://localhost:8000/media/
NOTIFICATION_CLAIM_LEASE_SECONDS=600
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Production requires exactly one encrypted SMTP mode; STARTTLS is the default.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15

# Development can mark signature-validated files clean without a malware engine.
# Production always ignores this allowance and remains fail-closed.
ATTACHMENT_ALLOW_UNSCANNED_IN_DEVELOPMENT=True
ATTACHMENT_SCANNER_COMMAND=
ATTACHMENT_SCAN_TIMEOUT=60

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_STARTER_FALLBACK=false
NEXT_PUBLIC_IMAGE_HOSTNAME=
NEXT_PUBLIC_COMPANY_NAME=WANSHANG
NEXT_PUBLIC_COMPANY_TAGLINE=Trailer Axles & Suspension Systems
NEXT_PUBLIC_SALES_EMAIL=simingzhu727@gmail.com
NEXT_PUBLIC_SALES_PHONE=+86 15253754552
NEXT_PUBLIC_COMPANY_ADDRESS=Liangshan Subdistrict, Liangshan County, Shandong Province, China
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_MAP_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Website assistant: AI providers and their API keys are entered in the admin
# (Assistant > AI providers) and stored encrypted with DJANGO_SECRET_KEY.
TURNSTILE_REQUIRED=False
TURNSTILE_TIMEOUT=8

# Failed Admin sign-ins are counted per trusted client IP in the shared cache.
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_FAILURE_WINDOW=900
